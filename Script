-- Objetivo:
-- Limpiar datos de prueba para volver a probar el flujo:
-- control-obras -> equipos-maquinaria -> documentos-obra -> evidencias
-- ============================================================

USE db_prodeinc_obras;

-- Evita error 1175 de MySQL Workbench Safe Update Mode
SET SQL_SAFE_UPDATES = 0;

-- Desactiva temporalmente restricciones FK para limpiar por dependencias
SET FOREIGN_KEY_CHECKS = 0;

-- ============================================================
-- PROCEDIMIENTO TEMPORAL:
-- Limpia una tabla solo si existe.
-- Así evitamos error 1146: table doesn't exist.
-- ============================================================

DROP PROCEDURE IF EXISTS sp_limpiar_tabla_si_existe;

DELIMITER $$

CREATE PROCEDURE sp_limpiar_tabla_si_existe(IN p_table_name VARCHAR(128))
BEGIN
    DECLARE v_exists INT DEFAULT 0;

    DECLARE CONTINUE HANDLER FOR SQLEXCEPTION
    BEGIN
        SELECT CONCAT('Advertencia: no se pudo limpiar la tabla ', p_table_name) AS mensaje;
    END;

    SELECT COUNT(*)
    INTO v_exists
    FROM information_schema.tables
    WHERE table_schema = DATABASE()
      AND table_name = p_table_name;

    IF v_exists > 0 THEN
        SET @sql_delete = CONCAT('DELETE FROM `', p_table_name, '`');
        PREPARE stmt_delete FROM @sql_delete;
        EXECUTE stmt_delete;
        DEALLOCATE PREPARE stmt_delete;

        SET @sql_reset = CONCAT('ALTER TABLE `', p_table_name, '` AUTO_INCREMENT = 1');
        PREPARE stmt_reset FROM @sql_reset;
        EXECUTE stmt_reset;
        DEALLOCATE PREPARE stmt_reset;

        SELECT CONCAT('Tabla limpiada: ', p_table_name) AS mensaje;
    ELSE
        SELECT CONCAT('Tabla no existe, se omite: ', p_table_name) AS mensaje;
    END IF;
END$$

DELIMITER ;

