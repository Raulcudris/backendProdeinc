-- ============================================================
-- SCRIPT DE LIMPIEZA MVP PRODEINC
-- Base de datos: db_prodeinc_obras
-- Objetivo:
-- Limpiar datos de prueba para volver a ejecutar el flujo MVP
-- por Gateway sin errores de duplicados ni llaves foráneas.
-- ============================================================

USE db_prodeinc_obras;

SET SQL_SAFE_UPDATES = 0;
SET FOREIGN_KEY_CHECKS = 0;

-- ============================================================
-- PROCEDIMIENTO TEMPORAL PARA TRUNCAR TABLAS SOLO SI EXISTEN
-- ============================================================

DROP PROCEDURE IF EXISTS sp_truncate_if_exists;

DELIMITER $$

CREATE PROCEDURE sp_truncate_if_exists(IN p_table_name VARCHAR(128))
BEGIN
    DECLARE v_exists INT DEFAULT 0;

    SELECT COUNT(*)
    INTO v_exists
    FROM information_schema.TABLES
    WHERE TABLE_SCHEMA = DATABASE()
      AND TABLE_NAME = p_table_name;

    IF v_exists > 0 THEN
        SET @sql_stmt = CONCAT('TRUNCATE TABLE `', p_table_name, '`');
        PREPARE stmt FROM @sql_stmt;
        EXECUTE stmt;
        DEALLOCATE PREPARE stmt;

        SELECT CONCAT('Tabla limpiada: ', p_table_name) AS mensaje;
    ELSE
        SELECT CONCAT('Tabla no existe, se omite: ', p_table_name) AS mensaje;
    END IF;
END$$

DELIMITER ;

