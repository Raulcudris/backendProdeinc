          }
        },
        {
          "name": "Consultar Proveedores Activos",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gateway_url}}/api/proveedores/proveedores/by-estado?estado=1"
          }
        },
        {
          "name": "Buscar por Razón Social",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gateway_url}}/api/proveedores/proveedores/pages?currentpage=1&pagesize=10&parameter=RAZON_SOCIAL&filter=Maquinaria"
          }
        },
        {
          "name": "Actualizar Proveedor",
          "request": {
            "method": "PUT",
            "header": [
